+function renderSlideOverlays(slide: Slide | null, bubbleDefinitions: BubbleDefinition[] | undefined): JSX.Element | null {
+  if (!slide) return null;
+  const overlays = (slide.overlays ?? [])
+    .filter((overlay) => !overlay.hidden)
+    .sort((a, b) => a.zIndex - b.zIndex);
+  if (!overlays.length) return null;
+
+  const bubbleDefs = new Map<string, BubbleDefinition>();
+  for (const def of bubbleDefinitions ?? []) {
+    bubbleDefs.set(def.bubbleDefId, def);
+  }
+
+  return (
+    <div className="overlay-layer" aria-hidden>
+      {overlays.map((overlay) => {
+        const bubbleDef = overlay.bubbleDefId ? bubbleDefs.get(overlay.bubbleDefId) : undefined;
+        const textStyle: CSSProperties = {
+          fontFamily: bubbleDef?.defaultStyle.fontFamily,
+          fontSize: bubbleDef?.defaultStyle.fontSize,
+          fontWeight: bubbleDef?.defaultStyle.fontWeight,
+          color: bubbleDef?.defaultStyle.textColor ?? '#fff',
+          textAlign: bubbleDef?.defaultStyle.textAlign,
+          padding: `${(bubbleDef?.defaultStyle.paddingY ?? 0.06) * 100}% ${(bubbleDef?.defaultStyle.paddingX ?? 0.06) * 100}%`,
+        };
+
+        return (
+          <div key={overlay.overlayId} className="slide-overlay" style={overlayStyle(overlay)}>
+            {overlay.kind === 'speech-bubble' ? (
+              <>
+                {bubbleDef?.pngSrc && (
+                  <img
+                    className="slide-overlay-bubble"
+                    src={bubbleDef.pngSrc}
+                    alt=""
+                    draggable={false}
+                  />
+                )}
+                <div className="slide-overlay-text bubble" style={textStyle}>
+                  {normalizeTextForOverlay(overlay.text)}
+                </div>
+              </>
+            ) : (
+              <div className="slide-overlay-text plain" style={textStyle}>
+                {normalizeTextForOverlay(overlay.text)}
+              </div>
+            )}
+            <div className="slide-overlay-badge">{overlay.bubbleId}</div>
+          </div>
+        );
+      })}
+    </div>
+  );
+}
