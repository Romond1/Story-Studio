+  };
+}
+
+function bubbleIdNumber(raw: string | undefined): number | null {
+  if (!raw) return null;
+  const match = /^B(\d+)$/i.exec(raw.trim());
+  if (!match) return null;
+  return Number(match[1]);
+}
+
+function normalizeSlideOverlays(rawOverlays: any, nowIso: string): { overlays: SlideOverlay[]; nextBubbleSeq: number } {
+  const input = Array.isArray(rawOverlays) ? rawOverlays : [];
+  const usedBubbleIds = new Set<string>();
+  const overlays: SlideOverlay[] = [];
+  let maxBubbleSeq = 0;
+
+  for (let index = 0; index < input.length; index += 1) {
+    const raw = input[index] ?? {};
+    const geometry = raw.geometry
+      ? normalizeOverlayGeometry(raw.geometry)
+      : normalizeOverlayGeometry(raw);
+    const kind = raw.kind === 'speech-bubble' || raw.type === 'speechBubble'
+      ? 'speech-bubble'
+      : 'text';
+
+    const normalized: SlideOverlay = {
+      overlayId: typeof raw.overlayId === 'string' && raw.overlayId ? raw.overlayId : (typeof raw.id === 'string' && raw.id ? raw.id : randomUUID()),
+      bubbleId: typeof raw.bubbleId === 'string' ? raw.bubbleId.trim() : '',
+      kind,
+      bubbleDefId: typeof raw.bubbleDefId === 'string' ? raw.bubbleDefId : undefined,
+      text: typeof raw.text === 'string' ? raw.text : '',
+      geometry,
+      zIndex: typeof raw.zIndex === 'number' && Number.isFinite(raw.zIndex) ? raw.zIndex : index,
+      locked: typeof raw.locked === 'boolean' ? raw.locked : false,
+      hidden: typeof raw.hidden === 'boolean' ? raw.hidden : undefined,
+      createdAt: typeof raw.createdAt === 'string' ? raw.createdAt : nowIso,
+      updatedAt: typeof raw.updatedAt === 'string' ? raw.updatedAt : nowIso,
+    };
+
+    const bubbleSeq = bubbleIdNumber(normalized.bubbleId);
+    if (!normalized.bubbleId || bubbleSeq === null || usedBubbleIds.has(normalized.bubbleId)) {
+      normalized.bubbleId = '';
+    } else {
+      usedBubbleIds.add(normalized.bubbleId);
+      maxBubbleSeq = Math.max(maxBubbleSeq, bubbleSeq);
+    }
+
+    overlays.push(normalized);
+  }
+
+  let nextBubbleSeq = maxBubbleSeq + 1;
+  for (const overlay of overlays) {
+    if (overlay.bubbleId) continue;
+    overlay.bubbleId = `B${nextBubbleSeq}`;
+    usedBubbleIds.add(overlay.bubbleId);
+    nextBubbleSeq += 1;
+  }
+
+  return { overlays, nextBubbleSeq: Math.max(1, nextBubbleSeq) };
+}
