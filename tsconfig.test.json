{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2021"],
    "outDir": "dist-test",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/shared/types.ts",
    "src/shared/sectionMutations.ts",
    "src/shared/sectionMutations.test.ts",
    "src/shared/audioRoutingPlan.ts",
    "src/shared/audioRoutingPlan.test.ts",
    "src/shared/badgeStudents.ts",
    "src/shared/badgeStudents.test.ts",
    "src/shared/videoAudio.ts",
    "src/shared/videoAudio.test.ts"
  ]
}
